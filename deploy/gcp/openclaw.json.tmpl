{
  "gateway": {
    "mode": "local",
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["https://openclaw.alwynventures.com"],
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "plugins": {
    "deny": ["bonjour", "device-pair", "phone-control"]
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": {
        "source": "env",
        "provider": "default",
        "id": "DISCORD_BOT_TOKEN"
      },
      "groupPolicy": "allowlist",
      "guilds": {
        "${DISCORD_SERVER_ID}": {
          "requireMention": false,
          "users": ["${DISCORD_USER_ID_1}", "${DISCORD_USER_ID_2}"]
        }
      },
      "dmPolicy": "allowlist",
      "allowFrom": ["${DISCORD_USER_ID_1}", "${DISCORD_USER_ID_2}"],
      "commands": { "native": true }
    }
  },
  "models": {
    "providers": {
      "nvidia": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "models": [
          { "id": "meta/llama-3.3-70b-instruct", "name": "Llama 3.3 70B Instruct", "contextTokens": 131072 },
          { "id": "nvidia/llama-3.3-nemotron-super-49b-v1.5", "name": "Nemotron Super 49B v1.5", "contextTokens": 131072 },
          { "id": "deepseek-ai/deepseek-v3.1-terminus", "name": "DeepSeek V3.1 Terminus", "contextTokens": 131072 }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "nvidia/meta/llama-3.3-70b-instruct",
        "fallbacks": ["nvidia/nvidia/llama-3.3-nemotron-super-49b-v1.5", "nvidia/deepseek-ai/deepseek-v3.1-terminus"]
      }
    }
  },
  "session": {
    "threadBindings": { "enabled": true, "idleHours": 24 }
  }
}
